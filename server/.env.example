# 服务端口（前端默认代理到 8080）
PORT=8080

# JWT 密钥（必须显式填写强随机字符串，至少 32 字符；除测试环境外缺失或过短会直接启动失败）
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token 过期时间（建议 1d 以内，配合 token version 实现改密/禁用后即时失效）
JWT_EXPIRES_IN=1d

# 允许的 CORS 来源（逗号分隔多来源；生产环境禁止 *，必须显式列出前端域名）
CORS_ORIGIN=http://localhost:5173

# 上传文件存储目录
UPLOAD_DIR=uploads

# Qwen via DashScope; choose the endpoint matching your account region.
# 默认关闭所有会调用外部付费模型的开关，确认预算与配额后再按需打开。
AGENT_ENABLED=false
LLM_MODEL=qwen3.8-max
LLM_API_KEY=sk-your-dashscope-api-key
LLM_BASE_URL=https://api.beijing.maas.aliyuncs.com/compatible-mode/v1
AGENT_RUN_TIMEOUT_MS=60000
# 跨实例运行锁租约（毫秒），默认 AGENT_RUN_TIMEOUT_MS + 30000；进程崩溃后靠租约自动释放
#AGENT_RUN_LOCK_TTL_MS=90000
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_SESSIONS=1000

# ===== ReAct 推理流可见（仅通义千问 DashScope 生效，DeepSeek 无推理流）=====
AGENT_ENABLE_THINKING=true
AGENT_MAX_REASONING_CHARS=4000

# ===== LLM Wiki（结构化知识库：实体/关系）=====
WIKI_ENABLED=false
WIKI_EXTRACT_ENABLED=false
# 知识抽取 LLM 调用超时（毫秒）：后台任务，独立于前端问答的 AGENT_RUN_TIMEOUT_MS
EXTRACTION_TIMEOUT_MS=180000

# ===== Agent 长期记忆 =====
MEMORY_ENABLED=false
QA_MEMORY_TOP_K=3
QA_MEMORY_MIN_SIM=0.90

# ===== RAG 向量检索 =====
# 纯 JS 向量库，零外部进程，数据持久化到 .runtime/vectors.json
RAG_ENABLED=false
# DashScope embedding API Key（与 LLM_API_KEY 独立，需要在阿里云百炼平台获取）
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# 最终返回给 Agent 的条数（工具层硬上限 10）
RAG_TOP_K=5
# 召回候选池大小：融合/精排前的候选数量，与最终返回条数独立
RAG_RECALL_TOP_K=20

# ===== Rerank 精排（可选，默认关闭；失败/超时自动降级为融合排序）=====
RERANK_ENABLED=false
RERANK_MODEL=qwen3-rerank
# 留空时依次回退 EMBEDDING_API_KEY / LLM_API_KEY
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_STYLE=compatible
# 精排后保留条数 / 单次精排请求超时（毫秒）
RERANK_TOP_N=5
RERANK_TIMEOUT_MS=8000

# ===== 文档文件上传 =====
# 单文件大小上限（MB）；允许扩展名 .md / .markdown / .txt / .docx
DOC_UPLOAD_MAX_MB=10

# ===== 异步索引任务队列（失败指数退避重试）=====
INDEX_MAX_ATTEMPTS=3
INDEX_RETRY_BASE_DELAY_MS=2000

# ===== 对象存储删除 outbox（可选，均有默认值）=====
# 删除文档时写入 storage_deletion_outbox，由后台 worker 重试调用对象存储删除；
# 失败按指数退避重试，达到上限标记 failed，可通过 admin 接口手动重试。
STORAGE_DELETION_MAX_ATTEMPTS=5
STORAGE_DELETION_RETRY_BASE_DELAY_MS=5000
STORAGE_DELETION_RETRY_MAX_DELAY_MS=3600000
# 后台轮询间隔（毫秒）/ 单批领取条数 / processing 锁超时（毫秒）
STORAGE_DELETION_INTERVAL_MS=30000
STORAGE_DELETION_BATCH_SIZE=20
STORAGE_DELETION_LOCK_TIMEOUT_MS=300000

# ===== 向量存储驱动（选择 local 或 upstash） =====
# 默认 local，无需外部服务；选择 upstash 时请填好下列凭证
VECTOR_STORE=local
UPSTASH_VECTOR_URL=https://<region>.api.upstash.com/vector/v1/<instance>
UPSTASH_VECTOR_API_KEY=<your_upstash_vector_key>
## Upstash Redis（用于队列和简单 KV 映射）
## 注意：用于 `bullmq` 的 ioredis 需要 Redis URL（通常为 rediss:// 或 redis://，包含密码）
## 示例： rediss://:<password>@<host>:<port>
UPSTASH_REDIS_URL=rediss://:<your_redis_password>@<region>.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_TOKEN=<your_upstash_redis_token>

# ===== Redis（可选：多实例共享限流计数与 Agent 运行锁）=====
# 留空时退化为进程内实现（单实例部署够用）；多实例部署请填写 redis:// 或 rediss:// 地址。
# 注意：这里只认 REDIS_URL，不会复用上面的 Upstash REST 地址。
REDIS_URL=
# 键前缀：多个环境共用同一 Redis 时用于隔离
REDIS_KEY_PREFIX=ekb

# 索引队列驱动：可选值 `memory`（默认）或 `bullmq`（使用 Upstash Redis）
INDEX_QUEUE_DRIVER=memory
# 可选：队列名，默认 index-queue
INDEX_QUEUE_NAME=index-queue

# ===== Backblaze B2 (可选：用于对象存储) =====
# 如果要把上传文件存储到 Backblaze B2，请填写以下凭证并在生产环境保密管理：
# - B2_ACCOUNT_ID: Backblaze Key ID
# - B2_APPLICATION_KEY: Backblaze Application Key
# - B2_BUCKET_ID: Backblaze Bucket ID（用于上传 API）
# - B2_BUCKET_NAME: Backblaze Bucket 名称（用于生成公有下载 URL，可选）
# 示例：
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# 使用说明：
# 1) 在 server/.env 中填写上述变量（不要提交到 VCS）。
# 2) 上传接口会在检测到这些变量已配置时把原始文件同时上传到 B2，
#    并把返回的 `fileId`/`fileName`/`url` 原子写入 documents.storage（JSONB）。
# 3) 删除文档时会读取该字段并写入 storage_deletion_outbox 删除任务，
#    由后台 worker 异步调用 B2 删除对应文件版本；失败指数退避重试，
#    可在 /api/observability/storage-deletions 查看与手动重试。

# ===== 数据库（仅支持 Supabase） =====
# 本项目没有可切换的本地/内存数据库：服务启动时强制连接 Supabase，
# 未配置下面两个变量会直接启动失败（不会静默回退到内存数据）。
# SUPABASE_URL: Supabase 项目 URL（例如 https://xyz.supabase.co，不要带 /rest/v1/ 后缀）
# SUPABASE_SERVICE_KEY: service_role key（服务端专用，绕过 RLS，切勿泄露）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 使用说明：
# 1) 创建 Supabase 项目后，在控制台左侧 "SQL Editor" 中按编号依次运行
#    server/migrations/*.sql 以建表（含 0007 的 documents.storage 字段、
#    0008 的 storage_deletion_outbox 表与 0009 的原子计数函数/token_version）。
# 2) 在 server/.env 中填入 SUPABASE_URL 与 SUPABASE_SERVICE_KEY
#    （Project Settings → API → service_role key）。
# 3) 数据库为空时需要通过注册接口创建账号；服务不再写入演示种子数据。
