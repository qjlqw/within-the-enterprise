# 服务端口（前端默认代理到 8080）
PORT=8080

# JWT 密钥（生产环境请替换为强随机字符串）
JWT_SECRET=a8f43872-a3d3-4e66-93dc-c95dbd93ff61

# Token 过期时间
JWT_EXPIRES_IN=7d

# 上传文件存储目录
UPLOAD_DIR=uploads

# Qwen via DashScope; choose the endpoint matching your account region.
AGENT_ENABLED=true
LLM_MODEL=qwen3.8-max
LLM_API_KEY=sk-KFCcrazyDay4Vme50Eatquickly
LLM_BASE_URL=https://api.deepseek.com
AGENT_RUN_TIMEOUT_MS=60000
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_SESSIONS=1000

# ===== RAG 向量检索 =====
# 纯 JS 向量库，零外部进程，数据持久化到 .runtime/vectors.json
RAG_ENABLED=true
# DashScope embedding API Key（与 LLM_API_KEY 独立，需要在阿里云百炼平台获取）
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# 最终返回给 Agent 的条数（工具层硬上限 10）
RAG_TOP_K=5
# 召回候选池大小：融合/精排前的候选数量，与最终返回条数独立
RAG_RECALL_TOP_K=20

# ===== Rerank 精排（可选，默认关闭；失败/超时自动降级为融合排序）=====
RERANK_ENABLED=false
RERANK_MODEL=qwen3-rerank
# 留空时依次回退 EMBEDDING_API_KEY / LLM_API_KEY
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_STYLE=compatible
# 精排后保留条数 / 单次精排请求超时（毫秒）
RERANK_TOP_N=5
RERANK_TIMEOUT_MS=8000

# ===== 文档文件上传 =====
# 单文件大小上限（MB）；允许扩展名 .md / .markdown / .txt / .docx
DOC_UPLOAD_MAX_MB=10

# ===== 异步索引任务队列（失败指数退避重试）=====
INDEX_MAX_ATTEMPTS=3
INDEX_RETRY_BASE_DELAY_MS=2000

# ===== 向量存储驱动（选择 local 或 upstash） =====
# 如果选择 upstash，请填入以下凭证
VECTOR_STORE=upstash
UPSTASH_VECTOR_URL=https://<region>.api.upstash.com/vector/v1/<instance>
UPSTASH_VECTOR_API_KEY=<your_upstash_vector_key>
## Upstash Redis（用于队列和简单 KV 映射）
## 注意：用于 `bullmq` 的 ioredis 需要 Redis URL（通常为 rediss:// 或 redis://，包含密码）
## 示例： rediss://:<password>@<host>:<port>
UPSTASH_REDIS_URL=rediss://:<your_redis_password>@<region>.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_TOKEN=<your_upstash_redis_token>

# 索引队列驱动：可选值 `memory`（默认）或 `bullmq`（使用 Upstash Redis）
INDEX_QUEUE_DRIVER=bullmq
# 可选：队列名，默认 index-queue
INDEX_QUEUE_NAME=index-queue

# ===== Backblaze B2 (可选：用于对象存储) =====
# 如果要把上传文件存储到 Backblaze B2，请填写以下凭证并在生产环境保密管理：
# - B2_ACCOUNT_ID: Backblaze Key ID
# - B2_APPLICATION_KEY: Backblaze Application Key
# - B2_BUCKET_ID: Backblaze Bucket ID（用于上传 API）
# - B2_BUCKET_NAME: Backblaze Bucket 名称（用于生成公有下载 URL，可选）
# 示例：
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# 使用说明：
# 1) 在 server/.env 中填写上述变量（不要提交到 VCS）。
# 2) 上传接口会在检测到这些变量已配置时把原始文件同时上传到 B2，
#    并把返回的 `fileId`/`fileName`/`url` 写入文档元数据 `doc.storage`（内存 DB 存储）。
# 3) 删除文档时会尝试调用 B2 删除对应文件版本；失败仅记录日志，不阻塞删除流程。

# ===== 数据库驱动（local 内存 / supabase 持久化） =====
# DB_DRIVER=local     —— 默认：内存数据库，重启后数据丢失
# DB_DRIVER=supabase  —— 使用 Supabase 作为持久化存储（推荐生产环境）
DB_DRIVER=local

# Supabase 后端（服务端）连接
# SUPABASE_URL: Supabase 项目 URL（例如 https://xyz.supabase.co，不要带 /rest/v1/ 后缀）
# SUPABASE_SERVICE_KEY: service_role key（服务端专用，绕过 RLS，切勿泄露）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 使用说明：
# 1) 创建 Supabase 项目后，在控制台左侧 "SQL Editor" 中运行
#    server/migrations/0001_supabase_schema.sql 以建表。
# 2) 在 server/.env 中设置 DB_DRIVER=supabase，并填入 SUPABASE_URL 与
#    SUPABASE_SERVICE_KEY（Project Settings → API → service_role key）。
# 3) 首次启动时若库为空，服务会自动写入演示种子数据；之后每次启动都会从
#    Supabase 全量读入（read-through），写操作通过 write-through 异步落库。
