{
  "name": "enterprise-knowledge-base-server",
  "version": "1.0.0",
  "description": "Express 后端服务 - 企业内部知识库",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/agent/*.test.js",
    "test:live": "node scripts/agent-evaluate.js --smoke",
    "eval:agent": "node scripts/agent-evaluate.js",
    "eval:retrieval": "node scripts/retrieval-evaluate.js",
    "eval:promptfoo": "npx -y promptfoo@latest eval -c test/eval/promptfooconfig.yaml",
    "eval:promptfoo:view": "npx -y promptfoo@latest view",
    "eval:judge": "python test/eval/judge_eval.py",
    "eval:judge:calibrate": "python test/eval/judge_eval.py --calibrate 20",
    "eval:compare": "node scripts/compare-reports.mjs",
    "reindex": "node scripts/reindex.js"
  },
  "engines": {
    "node": ">=20.12.0 <23"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/openai": "^1.5.8",
    "@langchain/textsplitters": "^1.0.1",
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "enterprise-knowledge-base": "file:..",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.10",
    "mammoth": "^1.12.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@upstash/redis": "*",
    "@upstash/vector": "*",
    "bullmq": "^6.3.8",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
